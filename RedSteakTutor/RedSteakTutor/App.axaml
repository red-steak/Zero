<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RedSteakTutor"
             x:Class="RedSteakTutor.App"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="ForestGreen" RegionColor="White" ErrorText="Red" />
                <ColorPaletteResources x:Key="Dark" Accent="DarkSeaGreen" RegionColor="Black" ErrorText="Red" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>