<UserControl xmlns="https://github.com/avaloniaui"
        
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiaryApp.ViewModels"
                xmlns:views="using:DiaryApp.Views"             
                
x:Class="DiaryApp.Views.MainView"
             x:DataType="vm:MainViewModel"
xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
               xmlns:markdown="clr-namespace:Markdown.Avalonia"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"            
             >

    <!-- Namapování události Loaded na příkaz ve ViewModelu -->
    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Loaded">
            <ia:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="240, 2*, 8, *">

                <ComboBox HorizontalAlignment="Stretch" Grid.Row="2" Grid.ColumnSpan="4"        
            ItemsSource="{Binding Messages}" 
            SelectedItem="{Binding LastMessage}" >
            <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <views:MessageKindImageView />
                        <TextBlock Padding="8" FontWeight="Bold" Text="{Binding Timestamp, StringFormat={}{0:dd.MM. HH:mm:ss}}" Margin="0,0,10,0"/>
                        <TextBlock Padding="8" FontWeight="Bold" Text="{Binding Message}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <views:MessageKindImageView />
                        <TextBlock FontWeight="Light" Text="{Binding Timestamp, StringFormat={}{0:dd.MM. HH:mm:ss.tttt}}" Margin="10,0,10,0"/>
                        <TextBlock FontWeight="Light" Text="{Binding Message}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>


            <Grid Grid.ColumnSpan="4" Grid.Row="0" DockPanel.Dock="Top" Margin="2" ColumnDefinitions="Auto, *, Auto">
                <TextBlock Text="Složka" FontWeight="Bold"
                           Padding="4"
                           FontSize="16"/>
                <TextBlock Grid.Column="1" Text="{Binding Folder}" FontSize="12"
                           Padding="8"/>
                <Button Grid.Column="2" Content="Změnit" Command="{Binding SelectFolderCommand}" CommandParameter="{Binding $parent[Window].StorageProvider}"/>
            </Grid>
        <!-- Sloupec 1: Seznam zápisů -->
        <DockPanel Grid.Column="0" Grid.Row="1">
            <Button DockPanel.Dock="Top"
                    Content="Seřadit dle data"
                    Command="{Binding ListViewModel.SortCommand}"
                    HorizontalAlignment="Stretch" Margin="10"/>
            <Button DockPanel.Dock="Bottom" 
                    Content="+ Nový zápis" 
                    Command="{Binding ListViewModel.CreateNewEntryCommand}" 
                    HorizontalAlignment="Stretch" Margin="10"/>
            <ListBox ItemsSource="{Binding ListViewModel.Entries}" 
                     SelectedItem="{Binding ListViewModel.SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl>
                            <TextBlock 
                                FontWeight="Bold"
                                Text="{Binding Date, StringFormat={}{0:yyyy MMMM d dddd}}" />
                            <TextBlock Text="{Binding Note}"/>                        
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Sloupec 2: Markdown Editor -->
        <DockPanel Grid.Column="1" Grid.Row="1" Margin="10">
            
            <DatePicker DockPanel.Dock="Top" SelectedDate="{Binding ListViewModel.SelectedEntry.DateOffset}" 
                       FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding ListViewModel.SelectedEntry.Note}"
                       FontWeight="Bold" FontSize="16" Margin="0,0,0,10" 
                       PlaceholderText="Poznámka"/>
            <CheckBox DockPanel.Dock="Top" IsChecked="{Binding ListViewModel.SelectedEntry.Trip}"
                      Content="Cestování" Margin="0,0,0,10"/>
            <CheckBox DockPanel.Dock="Top" IsChecked="{Binding ListViewModel.SelectedEntry.FreeTimeActivity}"
                      Content="Aktivita ve volném čase" Margin="0,0,0,10"/>
            <StackPanel
                DockPanel.Dock="Top" Orientation="Horizontal">
                <Label Content="Práce" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox 
                       PlaceholderText="Vyberte dnešní druh práce" 
                       SelectedValueBinding="{Binding Value}"
                       DisplayMemberBinding="{Binding Name}"
                       SelectedValue="{Binding ListViewModel.SelectedEntry.WorkDayKind}" 
                       ItemsSource="{Binding ListViewModel.SelectedEntry.WorkKinds}" Margin="0,0,0,10"/>
                </StackPanel>

            <Button DockPanel.Dock="Bottom" Margin="10"
                    Content="Uložit &amp; Publikovat (Commit &amp; Push)"             
                    Command="{Binding SaveAndPublishCommand}"
                    HorizontalAlignment="Stretch"/>
            <ScrollViewer>
                <TextBox AcceptsReturn="True"  
                    TextWrapping="Wrap"
                         Text="{Binding ListViewModel.SelectedEntry.EditorViewModel.MarkdownText, Mode=TwoWay}" />
                
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="2" Background="Gray" Width="4"/>

        <!-- Sloupec 3: HTML Náhled -->
        <Border Grid.Column="3" Grid.Row="1" Margin="10" Background="#1E1E1E" CornerRadius="5" Padding="10">
              <!-- MarkdownScrollViewer zrenderuje kód přímo do Avalonia prvků -->
                <md:MarkdownScrollViewer Markdown="{Binding ListViewModel.SelectedEntry.EditorViewModel.MarkdownText}">
                    <md:MarkdownScrollViewer.Engine>
                        <md:Markdown />
                    </md:MarkdownScrollViewer.Engine>
                </md:MarkdownScrollViewer>  
        </Border>

    </Grid>
</UserControl>
