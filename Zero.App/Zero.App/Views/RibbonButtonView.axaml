<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Zero.App.Views.Ribbon"
             xmlns:vms="using:Zero.Core.Ribbon"
             x:Class="Zero.App.Views.Ribbon.RibbonButtonView"
             x:DataType="vms:RibbonButtonViewModel">

    <StackPanel>

        <Button Classes="ribbon-button" 
                UseLayoutRounding="True"
                CornerRadius="5"
                BorderThickness="0"
                Margin="4,2"
                Background="{DynamicResource AcrylicLight}"
                Command="{Binding Command}"
                ToolTip.Tip="{Binding Tooltip}"
                Padding="3,1"
                HorizontalContentAlignment="Stretch"
                Width="{Binding Size, Converter={StaticResource RibbonSizeToWidthConverter}}"
                Height="{Binding Size, Converter={StaticResource RibbonSizeToHeightConverter}}">
            <Button.Styles>
                <Style Selector="Button:dark">
                    <Setter Property="Background"
                            Value="{DynamicResource AcrylicDark}"/>
                </Style>
            </Button.Styles>

              <Grid HorizontalAlignment="Stretch"
                      ColumnDefinitions="*, Auto"
                      RowDefinitions="Auto, Auto">
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        Source="{Binding Icon, Converter={StaticResource IconToBitmapConverter}, UpdateSourceTrigger=PropertyChanged}"
                        Width="{Binding Size, Converter={StaticResource RibbonSizeToIconSizeConverter}}"
                        Height="{Binding Size, Converter={StaticResource RibbonSizeToIconSizeConverter}}"
                        IsVisible="{Binding Size, Converter={StaticResource SizeToVisibilityConverter}}"                
                        HorizontalAlignment="Left"/>

                    <StackPanel
                           Orientation="Horizontal"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2">
                        <Image 
                           IsVisible="{Binding Size, Converter={StaticResource InvertedSizeToVisibilityConverter}}"
                           Source="{Binding Icon, Converter={StaticResource IconToBitmapConverter}, UpdateSourceTrigger=PropertyChanged}"
                           Width="{Binding Size, Converter={StaticResource RibbonSizeToIconSizeConverter}}"
                           Height="{Binding Size, Converter={StaticResource RibbonSizeToIconSizeConverter}}"
                           HorizontalAlignment="Right"/>
                        <TextBlock 
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           IsVisible="{Binding Size, Converter={StaticResource SizeToVisibilityConverter}}"
                           Text="{Binding Label}"
                           Margin="5,2,0,0"
                           FontSize="{Binding Size, Converter={StaticResource RibbonSizeToFontSizeConverter}}"/>
                    </StackPanel>
              </Grid>


        </Button>

        <TextBlock Text="{Binding KeyTip}"
                   HorizontalAlignment="Center"
                   FontSize="10"
                   Foreground="#888"
                   Margin="2,2,0,0"/>

    </StackPanel>

</UserControl>
