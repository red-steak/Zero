<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:app="using:Zero.App"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Zero.App.Views.Ribbon"
             xmlns:vm="using:Zero.App.ViewModels"
             Design.DataContext="vm:MainViewModel"
             x:DataType="vm:MainViewModel"
             x:Class="Zero.App.Views.Ribbon.RibbonView">
    <UserControl.Styles>
        <Style Selector="UserControl">
            <Setter Property="Background"
                    Value="{DynamicResource AcrylicLight}"/>
        </Style>

        <Style Selector="UserControl:dark">
            <Setter Property="Background"
                    Value="{DynamicResource AcrylicDark}"/>
        </Style>
    </UserControl.Styles>

        <TabControl ItemsSource="{Binding RibbonTabs}" Padding="3">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        MaxHeight="12"
                        Padding="-1"
                        Text="{Binding Header}" 
                        FontSize="{Binding Size, Converter={StaticResource RibbonSizeToFontSizeConverter}}"
                        Margin="2,0"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:RibbonTabView Padding="2"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

</UserControl>
