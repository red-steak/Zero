<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ribbon="using:Zero.Core.Ribbon"
             xmlns:views="clr-namespace:Zero.App.Views.Ribbon"
             x:Class="Zero.App.Views.Ribbon.RibbonGroupView"
             x:DataType="ribbon:RibbonGroupViewModel">

    <Border Classes="ribbon-group" 
            UseLayoutRounding="True"
            CornerRadius="5"
            Background="#AA66AA55"
            BorderBrush="#CCC" BorderThickness="3,0,1,0" Margin="2,1" Padding="2">
        <Border.Styles>
            <Style Selector="Border:dark">
                <Setter Property="Background"
                        Value="{DynamicResource MicaDark}"/>
            </Style>
        </Border.Styles>
            
        <DockPanel>

            <TextBlock 
                Height="20"
                DockPanel.Dock="Left"
                Text="{Binding Header}"
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="{Binding Size, Converter={StaticResource RibbonSizeToFontSizeConverter}}"
                Margin="1,1,1,0">
                <TextBlock.RenderTransform>
				    <RotateTransform Angle="-70"/>
                </TextBlock.RenderTransform>
            </TextBlock>


            <ItemsControl
                DockPanel.Dock="Top"
                Margin="0"
                Padding="0"
                ItemsSource="{Binding Commands}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:RibbonButtonView VerticalAlignment="Top" Margin="1,1,1,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </DockPanel>
    </Border>

</UserControl>
