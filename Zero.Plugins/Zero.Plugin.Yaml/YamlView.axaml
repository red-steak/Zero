<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zero.Plugin.Yaml"
             x:Class="Zero.Plugin.Yaml.YamlView"
             x:DataType="vm:YamlViewModel">

       <TextBox 
                 AcceptsReturn="True"
                 Text="{Binding YamlText}"
                 FontFamily="Consolas"
                 FontSize="14" />

</UserControl>