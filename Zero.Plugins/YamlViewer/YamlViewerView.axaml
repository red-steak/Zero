<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zero.Plugin.YamlViewer"
             x:Class="Zero.Plugin.YamlViewer.YamlViewerView"
             x:DataType="vm:YamlViewerViewModel">


    <Grid RowDefinitions="Auto,*" Margin="10">

        <TextBox Grid.Row="1"
                 AcceptsReturn="True"
                 Text="{Binding YamlText}"
                 FontFamily="Consolas"
                 FontSize="14" />
    </Grid>

</UserControl>
